<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<AnchorPane style="-fx-background-color: linear-gradient(to bottom right, #1a1a2e, #16213e, #0f3460);"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.library.controller.BookFormController">

    <VBox alignment="CENTER" spacing="20"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <VBox alignment="CENTER" spacing="14" maxWidth="520"
              style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 16; -fx-border-color: rgba(255,255,255,0.15); -fx-border-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 20, 0.3, 0, 4);">
            <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

            <!-- Dynamic Title -->
            <Label fx:id="formTitle" text="Add New Book" style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;"/>
            <Label fx:id="formSubtitle" text="Fill in the book details below" style="-fx-text-fill: #a0aec0; -fx-font-size: 13;"/>

            <!-- Error Label -->
            <Label fx:id="errorLabel" text="" style="-fx-text-fill: #fc8181; -fx-font-size: 12;" visible="false" managed="false"/>

            <!-- Form Fields in 2-column grid -->
            <GridPane hgap="14" vgap="10" alignment="CENTER">
                <!-- Row 0: Book ID -->
                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Book ID" style="-fx-text-fill: #cbd5e0; -fx-font-size: 11; -fx-font-weight: bold;"/>
                    <TextField fx:id="bookIdField" promptText="Auto-generated" prefHeight="36"
                               style="-fx-background-color: rgba(255,255,255,0.09); -fx-text-fill: #a0aec0; -fx-prompt-text-fill: #8a9bb5; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8; -fx-padding: 8 12;"/>
                </VBox>

                <!-- Row 0: ISBN -->
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="ISBN" style="-fx-text-fill: #cbd5e0; -fx-font-size: 11; -fx-font-weight: bold;"/>
                    <TextField fx:id="isbnField" promptText="e.g., 978-0743273565" prefHeight="36"
                               style="-fx-background-color: rgba(255,255,255,0.09); -fx-text-fill: white; -fx-prompt-text-fill: #8a9bb5; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8; -fx-padding: 8 12;"/>
                </VBox>

                <!-- Row 1: Title (full width) -->
                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                    <Label text="Title" style="-fx-text-fill: #cbd5e0; -fx-font-size: 11; -fx-font-weight: bold;"/>
                    <TextField fx:id="titleField" promptText="Enter book title" prefHeight="36"
                               style="-fx-background-color: rgba(255,255,255,0.09); -fx-text-fill: white; -fx-prompt-text-fill: #8a9bb5; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8; -fx-padding: 8 12;"/>
                </VBox>

                <!-- Row 2: Author -->
                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label text="Author" style="-fx-text-fill: #cbd5e0; -fx-font-size: 11; -fx-font-weight: bold;"/>
                    <TextField fx:id="authorField" promptText="Author name" prefHeight="36"
                               style="-fx-background-color: rgba(255,255,255,0.09); -fx-text-fill: white; -fx-prompt-text-fill: #8a9bb5; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8; -fx-padding: 8 12;"/>
                </VBox>

                <!-- Row 2: Genre -->
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Label text="Genre" style="-fx-text-fill: #cbd5e0; -fx-font-size: 11; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="genreCombo" promptText="Select genre" prefHeight="36" prefWidth="200"
                              style="-fx-background-color: rgba(255,255,255,0.09); -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8;">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Classic"/>
                                <String fx:value="Dystopian"/>
                                <String fx:value="Literary"/>
                                <String fx:value="Romance"/>
                                <String fx:value="Fantasy"/>
                                <String fx:value="Thriller"/>
                                <String fx:value="Sci-Fi"/>
                                <String fx:value="Fiction"/>
                                <String fx:value="Non-Fiction"/>
                                <String fx:value="Self-Help"/>
                                <String fx:value="Finance"/>
                                <String fx:value="Business"/>
                                <String fx:value="Technology"/>
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>

                <!-- Row 3: Publisher -->
                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="3">
                    <Label text="Publisher" style="-fx-text-fill: #cbd5e0; -fx-font-size: 11; -fx-font-weight: bold;"/>
                    <TextField fx:id="publisherField" promptText="Publisher name" prefHeight="36"
                               style="-fx-background-color: rgba(255,255,255,0.09); -fx-text-fill: white; -fx-prompt-text-fill: #8a9bb5; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8; -fx-padding: 8 12;"/>
                </VBox>

                <!-- Row 3: Year Published -->
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <Label text="Year Published" style="-fx-text-fill: #cbd5e0; -fx-font-size: 11; -fx-font-weight: bold;"/>
                    <TextField fx:id="yearField" promptText="e.g., 2024" prefHeight="36"
                               style="-fx-background-color: rgba(255,255,255,0.09); -fx-text-fill: white; -fx-prompt-text-fill: #8a9bb5; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8; -fx-padding: 8 12;"/>
                </VBox>

                <!-- Row 4: Quantity -->
                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="4">
                    <Label text="Quantity" style="-fx-text-fill: #cbd5e0; -fx-font-size: 11; -fx-font-weight: bold;"/>
                    <Spinner fx:id="quantitySpinner" prefHeight="36" prefWidth="200"
                             style="-fx-background-color: rgba(255,255,255,0.09); -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8;"/>
                </VBox>

                <!-- Row 4: Status -->
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="4">
                    <Label text="Status" style="-fx-text-fill: #cbd5e0; -fx-font-size: 11; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="statusCombo" promptText="Select status" prefHeight="36" prefWidth="200"
                              style="-fx-background-color: rgba(255,255,255,0.09); -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8;">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Available"/>
                                <String fx:value="Borrowed"/>
                                <String fx:value="Reserved"/>
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>

                <!-- Column constraints -->
                <columnConstraints>
                    <ColumnConstraints prefWidth="220" hgrow="ALWAYS"/>
                    <ColumnConstraints prefWidth="220" hgrow="ALWAYS"/>
                </columnConstraints>
            </GridPane>

            <!-- Action Buttons -->
            <HBox alignment="CENTER" spacing="14">
                <padding><Insets top="6"/></padding>
                <Button fx:id="saveButton" text="Save" onAction="#onSave" prefWidth="160" prefHeight="38"
                        style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
                <Button fx:id="cancelButton" text="Cancel" onAction="#onCancel" prefWidth="160" prefHeight="38"
                        style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: #a0aec0; -fx-font-size: 13; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.15); -fx-border-radius: 8; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </VBox>
</AnchorPane>
