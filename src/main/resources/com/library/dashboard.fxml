<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane style="-fx-background-color: #0f1923;"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.library.controller.DashboardController">

    <!-- TOP: Header Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-background-color: rgba(255,255,255,0.05); -fx-border-color: transparent transparent rgba(255,255,255,0.08) transparent;">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>

            <!-- App Title -->
            <Label text="📚 Library System" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>

            <!-- Spacer -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Logged-in user display -->
            <Label text="Welcome," style="-fx-text-fill: #a0aec0; -fx-font-size: 13;"/>
            <Label fx:id="usernameLabel" text="User" style="-fx-text-fill: #e2e8f0; -fx-font-size: 13; -fx-font-weight: bold;"/>

            <!-- Logout Button -->
            <Button fx:id="logoutButton" text="Logout" onAction="#onLogout"
                    style="-fx-background-color: rgba(252,129,129,0.15); -fx-text-fill: #fc8181; -fx-font-size: 12; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-color: rgba(252,129,129,0.3); -fx-border-radius: 8; -fx-cursor: hand; -fx-padding: 6 16;"/>
        </HBox>
    </top>

    <!-- CENTER: Content Area -->
    <center>
        <VBox spacing="16">
            <padding><Insets top="20" right="24" bottom="10" left="24"/></padding>

            <!-- Toolbar: Search + Add Button -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <TextField fx:id="searchField" promptText="🔍 Search by title or author..."
                           prefWidth="350" prefHeight="38"
                           style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: white; -fx-prompt-text-fill: #718096; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8; -fx-padding: 8 14;"/>
                <Button text="Search" onAction="#onSearch"
                        style="-fx-background-color: rgba(102,126,234,0.2); -fx-text-fill: #667eea; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-color: rgba(102,126,234,0.3); -fx-border-radius: 8; -fx-cursor: hand; -fx-padding: 8 20;"/>
                <Button text="Clear" onAction="#onClearSearch"
                        style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: #a0aec0; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8; -fx-cursor: hand; -fx-padding: 8 16;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="addBookButton" text="+ Add New Book" onAction="#onAddBook"
                        style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 8 20;"/>
            </HBox>

            <!-- Book Table -->
            <TableView fx:id="tableView" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #0f1923;">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colBookId" text="Book ID" minWidth="70" maxWidth="90">
                        <cellValueFactory><PropertyValueFactory property="bookId"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colTitle" text="Title" minWidth="140">
                        <cellValueFactory><PropertyValueFactory property="title"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colAuthor" text="Author" minWidth="110">
                        <cellValueFactory><PropertyValueFactory property="author"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colGenre" text="Genre" minWidth="70" maxWidth="100">
                        <cellValueFactory><PropertyValueFactory property="genre"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colPublisher" text="Publisher" minWidth="100">
                        <cellValueFactory><PropertyValueFactory property="publisher"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colYear" text="Year" minWidth="50" maxWidth="70">
                        <cellValueFactory><PropertyValueFactory property="yearPublished"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colIsbn" text="ISBN" minWidth="100">
                        <cellValueFactory><PropertyValueFactory property="isbn"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colQuantity" text="Qty" minWidth="40" maxWidth="55">
                        <cellValueFactory><PropertyValueFactory property="quantity"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colStatus" text="Status" minWidth="70" maxWidth="95">
                        <cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colActions" text="Actions" minWidth="130" maxWidth="150"/>
                </columns>
            </TableView>

            <!-- Pagination Bar -->
            <HBox alignment="CENTER" spacing="16">
                <padding><Insets top="4" bottom="8"/></padding>
                <Button fx:id="prevButton" text="← Previous" onAction="#onPrev"
                        style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: #a0aec0; -fx-font-size: 12; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8; -fx-cursor: hand; -fx-padding: 6 16;"/>
                <Label fx:id="pageLabel" text="Page 1 of 1" style="-fx-text-fill: #e2e8f0; -fx-font-size: 13;"/>
                <Button fx:id="nextButton" text="Next →" onAction="#onNext"
                        style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: #a0aec0; -fx-font-size: 12; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8; -fx-cursor: hand; -fx-padding: 6 16;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
