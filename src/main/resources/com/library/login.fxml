<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<AnchorPane style="-fx-background-color: linear-gradient(to bottom right, #1a1a2e, #16213e, #0f3460);"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.library.controller.LoginController">

    <!-- Centered login card -->
    <VBox alignment="CENTER" spacing="20"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <VBox alignment="CENTER" spacing="18" maxWidth="400"
              style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 16; -fx-border-color: rgba(255,255,255,0.15); -fx-border-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 20, 0.3, 0, 4);">
            <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

            <!-- App Title -->
            <Label text="📚" style="-fx-font-size: 48; -fx-text-fill: white;"/>
            <Label text="Library Management System" style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;"/>
            <Label text="Sign in to your account" style="-fx-text-fill: #a0aec0; -fx-font-size: 13;"/>

            <!-- Error Label -->
            <Label fx:id="errorLabel" text="" style="-fx-text-fill: #fc8181; -fx-font-size: 12;" visible="false" managed="false"/>

            <!-- Username -->
            <VBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Username" style="-fx-text-fill: #cbd5e0; -fx-font-size: 12; -fx-font-weight: bold;"/>
                <TextField fx:id="usernameField" promptText="Enter your username"
                           style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: white; -fx-prompt-text-fill: #718096; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8; -fx-padding: 10 14;"
                           prefHeight="40"/>
            </VBox>

            <!-- Password -->
            <VBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Password" style="-fx-text-fill: #cbd5e0; -fx-font-size: 12; -fx-font-weight: bold;"/>
                <PasswordField fx:id="passwordField" promptText="Enter your password"
                               style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: white; -fx-prompt-text-fill: #718096; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8; -fx-padding: 10 14;"
                               prefHeight="40"/>
            </VBox>

            <!-- Login Button -->
            <Button fx:id="loginButton" text="Login" onAction="#onLogin" prefWidth="320" prefHeight="40"
                    style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>

            <!-- Sign Up Link -->
            <HBox alignment="CENTER" spacing="4">
                <Label text="Don't have an account?" style="-fx-text-fill: #a0aec0; -fx-font-size: 12;"/>
                <Hyperlink fx:id="signupLink" text="Sign Up" onAction="#onSignUp"
                           style="-fx-text-fill: #667eea; -fx-font-size: 12; -fx-font-weight: bold; -fx-border-color: transparent;"/>
            </HBox>
        </VBox>
    </VBox>
</AnchorPane>
